# Copy this file to .streamlit/secrets.toml for local development, and paste the
# same contents into the "Secrets" box of the Streamlit Community Cloud app
# settings when deploying. Never commit the real .streamlit/secrets.toml.
[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
publishable_key = "YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
schema = "public"
